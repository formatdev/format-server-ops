{
  "policy": {
    "policy_id": "wazuh-alert-retention-90d",
    "description": "Delete Wazuh alert indices after 90 days",
    "schema_version": 17,
    "error_notification": null,
    "default_state": "retention",
    "states": [
      {
        "name": "retention",
        "actions": [],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": {
              "min_index_age": "90d"
            }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [
          {
            "retry": {
              "count": 3,
              "backoff": "exponential",
              "delay": "1m"
            },
            "delete": {}
          }
        ],
        "transitions": []
      }
    ],
    "ism_template": [
      {
        "index_patterns": [
          "wazuh-alerts-*"
        ],
        "priority": 1
      }
    ]
  }
}
